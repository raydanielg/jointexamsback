# EMAS environment configuration — copy to .env and fill in real values.
# Never commit real secrets.

# Core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,api.example.com
DJANGO_SETTINGS_MODULE=config.settings.production

# Database (PostgreSQL)
DATABASE_URL=postgres://emas:emas@postgres:5432/emas

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# JWT_SIGNING_KEY=           # defaults to SECRET_KEY
# JWT_ALGORITHM=HS256

# Auth security
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
INVITATION_TTL_HOURS=72
EMAIL_VERIFICATION_REQUIRED=False

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=False
PASSWORD_REQUIRE_LOWERCASE=False
PASSWORD_REQUIRE_DIGIT=False
PASSWORD_REQUIRE_SPECIAL=False

# CORS — development accepts every origin by default.
# For production set CORS_ALLOW_ALL_ORIGINS=False and list exact origins.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://app.example.com

# Throttling (optional overrides)
# THROTTLE_ANON=60/minute
# THROTTLE_USER=600/minute
# THROTTLE_LOGIN=10/minute
# THROTTLE_IMPORT=20/hour
# THROTTLE_REPORT=30/hour

# SMS provider — "console" (dev), "webhook" (generic HTTP gateway),
# or a dotted path to a custom apps.sms.providers.BaseSMSProvider subclass.
SMS_PROVIDER_BACKEND=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Email (used only for system notices, not result delivery)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@emas.local
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
